 "poems": [
  {
   "seq": "1",
   "text": "奥山の岩根の櫻いたつらに人もおしまぬ花やちるらん",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "白雲のたつきもしらぬ山櫻いつれの代よりまかひそめけん",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "降つみし松の白雲猶きえて深山は春の色そつれなき",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "白雲の消にし日より吉野山すゝの下草春をしるらし",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "春きぬとあくかれ出る深山へは去年みし花そしほり成けり",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "深山へやいつより花の散ぬらんまかひし雲の色そみたるゝ",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "春霞たちにし日より靑柳のかつらき山そみらく少き",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "夕まくれ空もみとりに行雲のたえまにみゆる春のかり金",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "ゆふかすみわたるつはさの色まてもみとりに歸る春の雁かね",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "歸るさのかりの羽風もうつもれぬ霞む末野の夕暮の空",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "山たかみゆふゐる雲にかすみつゝ歸やかりの聲そすくなき",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "山人も家路をいそく夕暮に尾上の雲をかへるかり金",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "遠さかる數さへ霞む春の日の夕ゐる雲にかへる雁かね",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "おほよとの松にもつらき夕へ哉見るめをよそに歸るかりかね",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "夕暮にいつくをさして歸る雁霞のうへを遠さかるらん",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "山河の岩行浪のわきかへりしはしはよとむ秋のもみちは",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "風の音に宇治のはし姫分て猶秋やま袖に浪も立らん",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "くるゝより月やとるへき氣色かな池のうき草秋風そふく",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "水の音の行瀨もみえぬ秋きりにたえ〓〓おとす宇治のはし姫",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "朝日山みねの紅葉の色みえて浪も秋なるうちの里かな",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "立田川木の葉なかるゝたえ〓〓に浪には月の影そ色そふ",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "龍田河秋行水はよとまねと散らぬかけせく風のしからみ",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "秋霧のふかき夕にせり河の千世のふる道誰たとるらん",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "色かはる野路の萩原あさな〓〓霧分なるゝさをしかのこゑ",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "朝露に置もとまらてさをしかのいる野の薄秋風そふく",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "秋萩の咲ちるをのゝ朝露にぬれてや鹿の妻をこふらん",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "さをしかの淚もゝろき朝露に妻こひわたるをのゝ篠原",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "朝露のおくのゝをのゝ小萩原かくろひて鳴さをしかのこゑ",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "宮城野やしからむ萩の朝露に涙もぬれて鹿そ鳴なる",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "旅人のいる野の袖のあさ露による鳴鹿の涙をやをく",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "朝霧のふかき野原にたつ鹿のをのれとぬれて鳴ぬ日はなし",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "しられてもかひやなくさの浦にほすみるめのよその袖にかけつゝ",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "をのつから夢にみえけん面影をそれとはかりは今やしるらん",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "いかにせんさのゝ中川中〓〓に流てしたに思ひたえなて",
   "kana": "",
   "speaker": "",
   "page": 256,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "すくもたく室のやしまの夕けふりむせふ心を人にしらせよ",
   "kana": "",
   "speaker": "",
   "page": 256,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "思ひかねけふこそ人にしらすけのまのゝ萩原色にいてつゝ",
   "kana": "",
   "speaker": "",
   "page": 256,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "いひそめし〓とのはよりそ人もうき只われからの思ひ成けり",
   "kana": "",
   "speaker": "",
   "page": 256,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "せきあへぬ涙もさらぬ枕よりまたしる袖になをやかこたん",
   "kana": "",
   "speaker": "",
   "page": 256,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "たちにける我下もえの夕煙心にけたぬ時のまぞなき",
   "kana": "",
   "speaker": "",
   "page": 256,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "思ふともしらてや人のなかむらん我のみぬるゝ有明の月",
   "kana": "",
   "speaker": "",
   "page": 256,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "曉のね覺の袖のほとはかりうさもつらさも思ふものかは",
   "kana": "",
   "speaker": "",
   "page": 256,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "曉は猶うしとてもいかゝせん逢みぬさきの別ならねは",
   "kana": "",
   "speaker": "",
   "page": 256,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "物おもふね覺の床にうちそへて猶うらめしき曉のそら",
   "kana": "",
   "speaker": "",
   "page": 256,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "袖のうへにぬるゝかほなる影もうし別しまゝの有明の月",
   "kana": "",
   "speaker": "",
